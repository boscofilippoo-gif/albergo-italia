---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Giornata from '../components/Giornata.astro';
import CtaBand from '../components/CtaBand.astro';
import heroImg from '../assets/img/camera-balcone.jpg';
import bagno from '../assets/img/bagno.jpg';
import { rooms, roomAmenities, hotel } from '../data/hotel';

const info = [
  { t: 'Arrivo e partenza', d: `Check-in ${hotel.checkIn}. Check-out ${hotel.checkOut}. Per arrivi più tardi, avvisateci.` },
  { t: 'Bambini', d: 'Tutti i bambini sono benvenuti. Culla gratuita per i più piccoli (0–2 anni), su richiesta. Non sono disponibili letti aggiuntivi.' },
  { t: 'Animali', d: 'Ammessi su richiesta. Potrebbe essere previsto un piccolo supplemento.' },
  { t: 'Parcheggio', d: 'Area privata riservata agli ospiti, a due passi dall’ingresso.' },
  { t: 'Colazione', d: 'Inclusa: continentale o all’italiana, con torte fatte in casa.' },
  { t: 'Accessibilità', d: 'Camere e spazi pensati per ospiti con disabilità. Chiedeteci i dettagli prima di prenotare.' },
];
---

<Base title="Le camere · Albergo Italia, Varallo" description="Camere singole, matrimoniali, doppie e triple in un albergo storico nel centro di Varallo. Colazione inclusa, Wi-Fi, parcheggio riservato, animali ammessi.">
  <PageHero
    kicker="Le camere"
    title="Quattro modi"
    titleItalic="di restare."
    intro="Camere classiche, spaziose e pulitissime, con le finestre alte del vecchio convento sul corso o sul cortile. Il voto degli ospiti per la pulizia è 9 su 10."
    image={heroImg}
    alt="Camera con portafinestra aperta sul balcone e un albero giallo d’autunno"
    position="60% 50%"
  />

  <!-- Le tipologie -->
  <section class="bg-paper py-28 md:py-40">
    <div class="mx-auto flex max-w-[1600px] flex-col gap-28 px-5 md:gap-44 md:px-10">
      {
        rooms.map((r, i) => (
          <article id={r.slug} class="room grid scroll-mt-28 items-center gap-10 md:grid-cols-12">
            <div class:list={['relative md:col-span-7', { 'md:order-2 md:col-start-6': i % 2 === 1 }]}>
              <div class="overflow-clip" data-clip-reveal>
                <Image src={r.images[0].src} alt={r.images[0].alt} widths={[700, 1100, 1280]} sizes="(min-width: 768px) 58vw, 100vw" class="aspect-[4/3] w-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
              </div>
              {r.images[1] && (
                <div class:list={['absolute -bottom-12 hidden w-[38%] overflow-clip shadow-2xl md:block', i % 2 === 1 ? '-left-10' : '-right-10']} data-parallax="18">
                  <Image src={r.images[1].src} alt={r.images[1].alt} widths={[500]} sizes="22vw" class="aspect-[4/5] w-full object-cover" loading="lazy" />
                </div>
              )}
            </div>
            <div class:list={['md:col-span-4', i % 2 === 1 ? 'md:order-1 md:col-start-1' : 'md:col-start-9']}>
              <p class="eyebrow text-rosa" data-reveal>0{i + 1} · {r.guests}</p>
              <h2 class="display mt-4 text-[clamp(3.4rem,6vw,6.4rem)]" data-split>{r.name}</h2>
              <p class="eyebrow mt-6 text-ink-soft" data-reveal>{r.beds}</p>
              <p class="mt-6 max-w-sm text-[1.02rem] leading-relaxed text-ink-soft" data-reveal>{r.text}</p>
              <a href={`/contatti?camera=${r.slug}#prenota`} class="btn btn-dark mt-10" data-reveal>Chiedi disponibilità <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- In ogni camera -->
  <section class="bg-paper-2 py-28 md:py-40">
    <div class="mx-auto grid max-w-[1600px] items-center gap-12 px-5 md:grid-cols-12 md:px-10">
      <div class="md:col-span-5">
        <p class="eyebrow mb-8 flex items-center gap-4 text-rosa" data-reveal><span class="h-px w-10 bg-current"></span> In ogni camera</p>
        <h2 class="display text-[clamp(2.8rem,5vw,5.4rem)]" data-split>Tutto quello <em class="text-rosa">che serve.</em></h2>
        <ul class="mt-12 border-t border-line">
          {roomAmenities.map((a) => <li class="flex items-center justify-between border-b border-line py-4 text-[1rem]" data-reveal>{a}<span class="text-rosa">✓</span></li>)}
        </ul>
      </div>
      <figure class="md:col-span-6 md:col-start-7" data-parallax="-6">
        <div class="overflow-clip" data-clip-reveal>
          <Image src={bagno} alt="Bagno privato con doccia, lavabo e asciugamani" widths={[600]} sizes="(min-width: 768px) 45vw, 100vw" class="aspect-[4/5] w-full object-cover" loading="lazy" />
        </div>
        <figcaption class="eyebrow mt-4 text-ink-soft">Bagno privato in ogni camera</figcaption>
      </figure>
    </div>
  </section>

  <Giornata />

  <!-- Informazioni pratiche -->
  <section class="bg-paper py-28 md:py-40">
    <div class="mx-auto max-w-[1600px] px-5 md:px-10">
      <p class="eyebrow mb-8 flex items-center gap-4 text-rosa" data-reveal><span class="h-px w-10 bg-current"></span> Da sapere</p>
      <h2 class="display text-[clamp(2.8rem,5vw,5.4rem)]" data-split>Prima <em class="text-rosa">di partire.</em></h2>
      <dl class="mt-16 grid gap-x-16 border-t border-line md:grid-cols-2">
        {
          info.map((x) => (
            <div class="grid gap-2 border-b border-line py-8 sm:grid-cols-[12rem_1fr]" data-reveal>
              <dt class="display text-2xl">{x.t}</dt>
              <dd class="text-[0.98rem] leading-relaxed text-ink-soft">{x.d}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand title="La vostra camera" titleItalic="vi aspetta." />
</Base>
