---
import { Image } from 'astro:assets';
import salotto from '../assets/img/salotto-affrescato.jpg';
import scultura from '../assets/img/scultura-legno.jpg';
---

<section id="benvenuti" class="relative overflow-clip bg-paper py-32 md:py-44">
  <div class="mx-auto grid max-w-[1600px] gap-16 px-5 md:grid-cols-12 md:px-10">
    <div class="md:col-span-7">
      <p class="eyebrow mb-10 flex items-center gap-4 text-rosa" data-reveal>
        <span class="h-px w-10 bg-current"></span> Benvenuti
      </p>
      <p class="manifesto display text-[clamp(2.6rem,6vw,6.4rem)] !leading-[1.02]">
        Un antico <em class="text-rosa">convento</em> ai piedi del <em class="text-rosa">Sacro Monte</em>, curato come una casa.
      </p>
    </div>

    <div class="relative md:col-span-5 md:pt-24">
      <figure class="ml-auto w-[78%]" data-parallax="-10">
        <div class="overflow-clip" data-clip-reveal>
          <Image src={salotto} alt="Sala con soffitto affrescato e divano a righe" widths={[480, 602]} sizes="(min-width: 768px) 30vw, 78vw" class="aspect-[3/4] w-full object-cover" />
        </div>
      </figure>
      <figure class="-mt-28 w-[46%]" data-parallax="16">
        <div class="overflow-clip shadow-2xl" data-clip-reveal>
          <Image src={scultura} alt="Scultura in legno sul pianerottolo" widths={[400]} sizes="(min-width: 768px) 18vw, 46vw" class="aspect-[3/4] w-full object-cover" />
        </div>
      </figure>
    </div>
  </div>
</section>
