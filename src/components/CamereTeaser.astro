---
import { Image } from 'astro:assets';
import { rooms } from '../data/hotel';
---

<section class="relative bg-paper py-32 md:py-44">
  <div class="mx-auto max-w-[1600px] px-5 md:px-10">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div>
        <p class="eyebrow mb-8 flex items-center gap-4 text-rosa" data-reveal>
          <span class="h-px w-10 bg-current"></span> Le camere
        </p>
        <h2 class="display text-[clamp(3rem,6.5vw,7rem)]" data-split>Quattro modi <em class="text-rosa">di restare.</em></h2>
      </div>
      <a href="/camere" class="btn btn-dark" data-reveal>Scopri le camere <span aria-hidden="true">→</span></a>
    </div>

    <ul class="mt-16 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-4 md:mt-24">
      {
        rooms.map((r, i) => (
          <li class:list={['group', { 'lg:mt-24': i % 2 === 1 }]} data-reveal>
            <a href={`/camere#${r.slug}`} class="block">
              <div class="overflow-clip bg-paper-2">
                <Image
                  src={r.images[0].src}
                  alt={r.images[0].alt}
                  widths={[500, 800]}
                  sizes="(min-width: 1024px) 24vw, (min-width: 640px) 48vw, 100vw"
                  class="aspect-[4/5] w-full object-cover transition-transform duration-[1.4s] ease-[var(--ease-out-expo)] group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="mt-5 flex items-baseline justify-between gap-4">
                <h3 class="display text-4xl">{r.name}</h3>
                <span class="eyebrow text-ink-soft">{r.guests}</span>
              </div>
              <p class="mt-2 text-[0.92rem] text-ink-soft">{r.short}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
